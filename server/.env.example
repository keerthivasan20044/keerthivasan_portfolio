# ─────────────────────────────────────────────
# Keerthivasan Portfolio — Server Environment
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────

# MongoDB Atlas URI
# Get it from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://keerthi123:keerthi123@cluster0.fh5ncsy.mongodb.net/

# Server Port
PORT=5000

# Environment
NODE_ENV=development

# Frontend URL (for CORS)
# Local:      http://localhost:5173
# Production: https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# Admin key to access /api/messages (choose any secret string)
ADMIN_KEY=your_super_secret_admin_key_here
