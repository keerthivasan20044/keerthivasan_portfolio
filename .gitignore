# ─────────────────────────────────────────────
# .gitignore — Keerthivasan Portfolio
# ─────────────────────────────────────────────

# ── Environment Variables ─────────────────────
.env
.env.local
.env.production
.env.development
**/.env
**/.env.local
**/.env.production

# ── Node Modules ──────────────────────────────
node_modules/
**/node_modules/

# ── Build Outputs ─────────────────────────────
dist/
build/
.vite/
client/dist/

# ── Logs ──────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS Files ──────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ── IDE / Editor ──────────────────────────────
.vscode/settings.json
.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Testing ───────────────────────────────────
coverage/
.nyc_output/

# ── Misc ──────────────────────────────────────
*.tgz
*.zip
.cache/
.parcel-cache/
